# Copie para .env e substitua os valores marcados. Nunca versione o .env.
POSTGRES_DB=hcm_lab
POSTGRES_USER=hcm
# Gere com: python -c "import secrets;print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=TROQUE-POR-UMA-SENHA-ALEATORIA
POSTGRES_PORT=5433
# Obrigatório, mínimo de 32 caracteres. Gere com: python -c "import secrets;print(secrets.token_urlsafe(48))"
APP_SECRET=TROQUE-POR-UM-SEGREDO-ALEATORIO
# true quando servido por HTTPS
COOKIE_SECURE=false
# Swagger em /docs (deixe false fora do desenvolvimento)
ENABLE_API_DOCS=false
SESSION_HOURS=8
SESSION_IDLE_MINUTES=60
PASSWORD_MAX_AGE_DAYS=90
MAX_FAILED_LOGINS=5
LOCK_MINUTES=15
# Servidor de e-mail opcional para as notificações dos processos
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
